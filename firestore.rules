rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Regla equivalente a la solicitada: 
      // Permitir lectura y escritura hasta el 13 de abril de 2026
      allow read, write: if request.time < timestamp.date(2026, 4, 13);
    }
  }
}
